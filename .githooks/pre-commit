#!/usr/bin/env sh
set -e

# Enable with: git config core.hooksPath .githooks

# Block direct commits to main/master and the v2-high integration branch.
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
case "$branch" in
  main|master|v2-high)
    printf '\n\033[1;31mBlocked: direct commit to %s is not allowed.\033[0m\n\n' "$branch" >&2
    printf 'This repository is in production and publishes a public CLI.\n' >&2
    printf 'Create a feature branch first:\n\n' >&2
    printf '    git switch -c <branch-name>\n\n' >&2
    exit 1
    ;;
esac

# Scan staged changes for secrets.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact
else
  echo "WARNING: gitleaks not installed - skipping secret scan. Run 'brew install gitleaks' to enable."
fi

# Formatting and lints must be clean before a commit.
cargo fmt --check
cargo clippy --all-targets -- -D warnings
