# =============================================================================
# FusedFrames CLI — Environment Variables
# =============================================================================
# The CLI reads these two optional environment variables. Neither is required;
# the API key can also be stored in the user config file via
# `echo "ff_..." | fusedframes config set-key`.
# =============================================================================

# --- API Authentication ------------------------------------------------------
# [OPTIONAL] FusedFrames API key. If set, overrides the key in the config file.
# Create one at https://fusedframes.com/workspace/<your-workspace>/api-keys
FUSEDFRAMES_API_KEY=

# --- API Endpoint ------------------------------------------------------------
# [OPTIONAL] Override the API base URL. Defaults to https://api.fusedframes.com.
# Useful for pointing the CLI at a local dev instance of the API.
# FUSEDFRAMES_API_URL=http://localhost:3000
